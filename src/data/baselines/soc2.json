{
  "id": "soc2",
  "shortName": "SOC 2",
  "name": "SOC 2 (Trust Services Criteria)",
  "description": "AICPA Trust Services Criteria for Security. SOC 2 does not mandate specific numeric values, so these reflect widely accepted control-implementation choices for logical access (CC6), change management, and monitoring (CC7).",
  "reference": "https://www.aicpa-cima.com/topic/audit-assurance/audit-and-assurance-greater-than-soc-2",
  "settings": {
    "PasswordMinLength": { "desired": "12" },
    "PasswordComplexity": { "desired": "1" },
    "MaxPasswordAge": { "desired": "90" },
    "MinPasswordAge": { "desired": "1" },
    "PasswordHistorySize": { "desired": "12" },
    "ClearTextPassword": { "desired": "0" },
    "LockoutThreshold": { "desired": "5" },
    "LockoutDuration": { "desired": "30" },
    "ResetLockoutCounter": { "desired": "30" },
    "GuestAccountDisabled": { "desired": "0" },
    "LimitBlankPasswordUse": { "desired": "1" },
    "NoLMHash": { "desired": "1" },
    "LmCompatibilityLevel": { "desired": "5" },
    "RestrictAnonymousSAM": { "desired": "1" },
    "InactivityTimeoutSecs": { "desired": "900" },
    "UacEnableLUA": { "desired": "1" },
    "UacAdminPrompt": { "desired": "2" },
    "SmbV1Server": { "desired": "0" },
    "RdpRequireNla": { "desired": "1" },
    "RdpMinEncryption": { "desired": "3" },
    "FirewallDomainEnable": { "desired": "1" },
    "FirewallStandardEnable": { "desired": "1" },
    "FirewallPublicEnable": { "desired": "1" },
    "DisableAutoRun": { "desired": "255" },
    "PsScriptBlockLogging": { "desired": "1" },
    "AuditLogon": { "desired": "3" },
    "AuditAccountLogon": { "desired": "3" },
    "AuditAccountManage": { "desired": "3" },
    "AuditPolicyChange": { "desired": "3" },
    "AuditPrivilegeUse": { "desired": "2" },
    "AuditObjectAccess": { "desired": "3" },
    "AuditSystemEvents": { "desired": "3" }
  }
}
